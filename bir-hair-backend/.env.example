PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/bir_hair
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Optional — if unset, image uploads fall back to local disk storage (src/uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — defaults to "debug" in dev / "info" in production
LOG_LEVEL=

# Optional — online-payment option falls back to unavailable (COD still works) if unset.
# Customers are redirected to this link to pay manually; the order stays
# "Pending" until an admin marks it Paid in the admin panel.
BLUEVINE_PAYMENT_LINK=https://pay.bluevine.com/p/101328ad38314ab68a6d68e7b9df0672/pay/

# Optional — order shipping from admin falls back to unavailable if unset.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary